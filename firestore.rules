rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRequiredFields() {
      return request.resource.data.keys().hasAll(['title', 'updatedAt', 'content']);
    }

    function hasValidTitle() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120;
    }

    function hasValidContent() {
      return request.resource.data.content is string
        || request.resource.data.content is map;
    }

    function optionalNumber(fieldName, minValue, maxValue) {
      return !request.resource.data.keys().hasAny([fieldName])
        || (
          request.resource.data[fieldName] is number
          && request.resource.data[fieldName] >= minValue
          && request.resource.data[fieldName] <= maxValue
        );
    }

    function optionalBool(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is bool;
    }

    function optionalString(fieldName, maxSize) {
      return !request.resource.data.keys().hasAny([fieldName])
        || (
          request.resource.data[fieldName] is string
          && request.resource.data[fieldName].size() <= maxSize
        );
    }

    function optionalMap(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] is map;
    }

    function optionalList(fieldName, maxSize) {
      return !request.resource.data.keys().hasAny([fieldName])
        || (
          request.resource.data[fieldName] is list
          && request.resource.data[fieldName].size() <= maxSize
        );
    }

    function hasValidScorePayload() {
      return hasRequiredFields()
        && hasValidTitle()
        && hasValidContent()
        && request.resource.data.updatedAt is timestamp
        && optionalNumber('bpm', 20, 300)
        && optionalNumber('timeSigNum', 1, 16)
        && optionalNumber('timeSigDen', 1, 32)
        && optionalNumber('charResolution', 1, 64)
        && optionalNumber('globalKeyOffset', -24, 24)
        && optionalString('tone', 32)
        && optionalString('scaleMode', 32)
        && optionalString('sourceType', 16)
        && optionalString('compilerVersion', 80)
        && optionalString('referenceNotes', 4000)
        && optionalString('ownerUid', 160)
        && optionalString('publicId', 600)
        && optionalString('privateScoreId', 300)
        && optionalBool('reverb')
        && optionalBool('isPublic')
        && optionalMap('accidentals')
        && optionalMap('contentStorage')
        && optionalList('references', 8);
    }

    function hasValidScoreSummaryPayload() {
      return request.resource.data.keys().hasAll(['title', 'updatedAt', 'contentLength'])
        && hasValidTitle()
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.contentLength is number
        && request.resource.data.contentLength >= 0
        && request.resource.data.contentLength <= 20 * 1024 * 1024
        && optionalNumber('bpm', 20, 300)
        && optionalNumber('timeSigNum', 1, 16)
        && optionalNumber('timeSigDen', 1, 32)
        && optionalNumber('charResolution', 1, 64)
        && optionalNumber('globalKeyOffset', -24, 24)
        && optionalString('sourceType', 16)
        && optionalString('scaleMode', 32)
        && optionalString('tone', 32)
        && optionalString('referenceNotes', 4000)
        && optionalString('compilerVersion', 80)
        && optionalString('ownerUid', 160)
        && optionalString('publicId', 600)
        && optionalBool('reverb')
        && optionalBool('isPublic')
        && optionalMap('accidentals')
        && optionalMap('contentStorage')
        && optionalList('references', 8);
    }

    function isPublicScore() {
      return resource.data.isPublic == true;
    }

    function isPublicOwner() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /artifacts/{appId}/users/{userId}/scores/{scoreId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && hasValidScorePayload();
    }

    match /artifacts/{appId}/users/{userId}/scoreSummaries/{summaryId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && hasValidScoreSummaryPayload();
    }

    match /artifacts/{appId}/publicScores/{scoreId} {
      allow read: if isPublicScore();
      allow create, update: if isPublicOwner()
        && request.resource.data.isPublic == true
        && hasValidScorePayload();
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /artifacts/{appId}/publicScoreSummaries/{summaryId} {
      allow read: if isPublicScore();
      allow create: if isPublicOwner()
        && request.resource.data.isPublic == true
        && hasValidScoreSummaryPayload();
      allow update: if (
          isSignedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.isPublic == true
          && hasValidScoreSummaryPayload()
        ) || (
          isSignedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['copiedCount', 'updatedAt'])
          && request.resource.data.copiedCount is number
          && request.resource.data.copiedCount >= resource.data.copiedCount
          && request.resource.data.updatedAt is timestamp
        );
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
