{
  "name": "universe-rhythm-recorder",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0 --strictPort",
    "build": "node scripts/build-firebase-hosting.mjs",
    "build:vite": "node scripts/run-vite-build.mjs",
    "build:pages": "node scripts/build-github-pages.mjs",
    "build:firebase": "node scripts/build-firebase-hosting.mjs",
    "scores:slim:midi": "node scripts/slim-midi-score.mjs",
    "preview": "vite preview",
    "preview:pages": "npm run build:pages && node scripts/preview-github-pages.mjs",
    "preview:firebase": "npm run build:firebase && vite preview --outDir dist-fb",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "firebase": "^12.13.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.14.2",
    "tone": "^15.1.22",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^7.1.3",
    "@playwright/test": "^1.53.0"
  }
}
